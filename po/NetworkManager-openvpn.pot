"config: keysize <n>"
msgstr ""

#: properties/nm-openvpn-dialog.ui:1789
msgid ""
"Authenticate packets with HMAC using message digest algorithm. The default "
"is SHA1.\n"
"config: auth"
msgstr ""

#: properties/nm-openvpn-dialog.ui:1808
msgid "Ci_pher"
msgstr ""

#: properties/nm-openvpn-dialog.ui:1823
