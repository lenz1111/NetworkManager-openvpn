"Cipher Block Chaining mode).\n"
"config: cipher"
msgstr ""

#: properties/nm-openvpn-dialog.ui:1756
msgid "Use custom _size of cipher key"
msgstr ""

#: properties/nm-openvpn-dialog.ui:1760 properties/nm-openvpn-dialog.ui:1774
msgid ""
